# ── LoomDeploy Configuration ──────────────────────────────
# The install script (deploy.sh) fills this in automatically.
# You can also edit it manually and restart with: docker compose up -d

# Domain where your LoomDeploy dashboard will be served
APP_DOMAIN=deploy.yourdomain.com

# Email used by Traefik to request Let's Encrypt SSL certificates
ACME_EMAIL=admin@yourdomain.com

# Base domain for auto-generated project URLs (optional)
# Projects will get URLs like: myapp-a3f29c.apps.yourdomain.com
# Requires a wildcard DNS record: *.apps.yourdomain.com → your server IP
BASE_DOMAIN=apps.yourdomain.com

# Secret used to sign JWT tokens — MUST be a long random string in production
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite database path inside the backend container (no need to change)
DB_PATH=/var/lib/loomdeploy/data.db
